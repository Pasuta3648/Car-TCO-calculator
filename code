import React, { useState, useMemo, useEffect } from 'react';
import { Plus, Trash2, Info, BarChart3, Settings2, Zap, Moon, Sun, Fuel, Droplet } from 'lucide-react';

// Apple Human Interface Guidelines 预设色彩
const COLORS = {
  depreciation: '#FF3B30', // iOS Red
  energy: '#FF9500',      // iOS Orange
  insurance: '#007AFF',   // iOS Blue
  maintenance: '#34C759', // iOS Green
  repair: '#8E8E93',      // iOS Gray
  fixedMonthly: '#AF52DE' // iOS Purple
};

const LEGEND = [
  { key: 'depreciation', label: '折旧亏损', color: COLORS.depreciation },
  { key: 'energy', label: '能源消耗', color: COLORS.energy },
  { key: 'insurance', label: '保险费用', color: COLORS.insurance },
  { key: 'maintenance', label: '常规维保', color: COLORS.maintenance },
  { key: 'repair', label: '维修备用金', color: COLORS.repair },
  { key: 'fixedMonthly', label: '换电月租等', color: COLORS.fixedMonthly },
];

// 多台车对比时，循环分配不同的 Logo 主题色
const ICON_THEMES = [
  'bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400',
  'bg-emerald-50 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400',
  'bg-orange-50 dark:bg-orange-900/40 text-orange-600 dark:text-orange-500',
  'bg-purple-50 dark:bg-purple-900/40 text-purple-600 dark:text-purple-400',
  'bg-rose-50 dark:bg-rose-900/40 text-rose-600 dark:text-rose-400',
  'bg-cyan-50 dark:bg-cyan-900/40 text-cyan-600 dark:text-cyan-400'
];

export default function App() {
  const [isDark, setIsDark] = useState(false);
  const [isMounted, setIsMounted] = useState(false);

  // 触发图表生长动效
  useEffect(() => {
    const timer = setTimeout(() => setIsMounted(true), 150);
    return () => clearTimeout(timer);
  }, []);

  const [globalParams, setGlobalParams] = useState({
    years: 3,
    annualMileage: 11440,
    gasPrice: 8.5,
    elecPrice: 1.0,
  });

  const [cars, setCars] = useState([
    {
      id: '1',
      name: '2018 高可靠代步油车',
      type: 'gas', 
      initialCost: 60000,
      residualValue: 35000,
      energyConsumption: 8.0, 
      phevGasConsumption: 5.0, 
      evRatio: 50, 
      firstYearInsurance: 4000,
      maintenancePerYear: 1600,
      repairFundPerYear: 1000, 
      fixedMonthlyCost: 0,
    },
    {
      id: '2',
      name: '新款租电版纯电车',
      type: 'ev',
      initialCost: 100000,
      residualValue: 55250,
      energyConsumption: 14.0,
      phevGasConsumption: 5.0,
      evRatio: 50,
      firstYearInsurance: 6000,
      maintenancePerYear: 2500,
      repairFundPerYear: 0,
      fixedMonthlyCost: 400,
    }
  ]);

  const handleGlobalChange = (field, value) => {
    setGlobalParams(prev => ({ ...prev, [field]: parseFloat(value) || 0 }));
  };

  const handleCarChange = (id, field, value) => {
    setCars(prev => prev.map(car => 
      car.id === id ? { ...car, [field]: value } : car
    ));
  };

  const handleAddCar = () => {
    const newCar = {
      id: Date.now().toString(),
      name: `新增对比方案 ${cars.length + 1}`,
      type: 'phev',
      initialCost: 120000,
      residualValue: 60000,
      energyConsumption: 13.0,
      phevGasConsumption: 4.5,
      evRatio: 70,
      firstYearInsurance: 5000,
      maintenancePerYear: 2000,
      repairFundPerYear: 0,
      fixedMonthlyCost: 0,
    };
    setCars([...cars, newCar]);
  };

  const calculatedData = useMemo(() => {
    const { years, annualMileage, gasPrice, elecPrice } = globalParams;
    const totalMileage = years * annualMileage;

    return cars.map(car => {
      const depreciation = Math.max(0, car.initialCost - car.residualValue);
      
      let energyCost = 0;
      if (car.type === 'gas') {
        energyCost = (car.energyConsumption / 100) * gasPrice * totalMileage;
      } else if (car.type === 'ev') {
        energyCost = (car.energyConsumption / 100) * elecPrice * totalMileage;
      } else if (car.type === 'phev') {
        const evMileage = totalMileage * (car.evRatio / 100);
        const gasMileage = totalMileage * (1 - car.evRatio / 100);
        energyCost = ((car.energyConsumption / 100) * elecPrice * evMileage) + 
                     ((car.phevGasConsumption / 100) * gasPrice * gasMileage);
      }
      
      let insuranceCost = 0;
      const insuranceRates = [1, 0.85, 0.70, 0.60, 0.50]; 
      for (let i = 0; i < years; i++) {
        const rate = i < insuranceRates.length ? insuranceRates[i] : 0.50; 
        insuranceCost += car.firstYearInsurance * rate;
      }

      const maintenance = car.maintenancePerYear * years;
      const repair = car.repairFundPerYear * years;
      const fixedMonthly = car.fixedMonthlyCost * 12 * years;

      const totalTco = depreciation + energyCost + insuranceCost + maintenance + repair + fixedMonthly;

      return {
        ...car,
        breakdown: { depreciation, energy: energyCost, insurance: insuranceCost, maintenance, repair, fixedMonthly },
        totalTco
      };
    });
  }, [globalParams, cars]);

  const maxTco = useMemo(() => {
    if (calculatedData.length === 0) return 100000;
    const max = Math.max(...calculatedData.map(c => c.totalTco));
    return max > 0 ? max : 100000;
  }, [calculatedData]);

  useEffect(() => {
    document.body.style.backgroundColor = isDark ? '#09090b' : '#f4f4f5'; // 苹果质感背景色 (zinc-950/100)
  }, [isDark]);

  // 苹果级弹性动画类 (Spring Easing)
  const springAnim = "transition-all duration-[600ms] ease-[cubic-bezier(0.32,0.72,0,1)]";

  return (
    <div className={`${isDark ? 'dark' : ''} transition-colors duration-500`}>
      <div className="min-h-screen bg-zinc-100 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 font-sans p-4 md:p-8 flex flex-col">
        
        <div className="flex flex-col xl:flex-row gap-6 md:gap-8 flex-1 w-full max-w-[1800px] mx-auto">
          
          {/* ================= 左侧区域：可视化图表与全局控制 ================= */}
          <div className="w-full xl:w-5/12 flex flex-col gap-6 md:gap-8 xl:sticky xl:top-8 xl:h-[calc(100vh-4rem)] z-10">
            
            {/* 全局设置卡片 (Apple Card Style) */}
            <div className={`bg-white/80 dark:bg-zinc-900/80 backdrop-blur-2xl p-6 md:p-8 rounded-[28px] shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-none dark:border dark:border-white/5 shrink-0 ${springAnim}`}>
              <div className="flex items-center justify-between mb-6">
                <div className="flex items-center gap-3">
                  <div className="p-2.5 bg-blue-500/10 dark:bg-blue-500/20 rounded-xl">
                    <Settings2 size={22} className="text-blue-600 dark:text-blue-400" />
                  </div>
                  <h2 className="text-xl md:text-2xl font-bold tracking-tight">全局用车模型</h2>
                </div>
                <button 
                  onClick={() => setIsDark(!isDark)}
                  className={`p-2.5 rounded-full bg-zinc-100/80 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 hover:scale-105 active:scale-95 ${springAnim}`}
                  title="外观模式"
                >
                  {isDark ? <Sun size={20} /> : <Moon size={20} />}
                </button>
              </div>
              
              <div className="grid grid-cols-2 gap-x-6 gap-y-6">
                {[
                  { label: '持有年限 (年)', key: 'years', min: 1, max: 20, step: 1 },
                  { label: '年行驶里程 (km)', key: 'annualMileage', min: 1000, max: 100000, step: 1000 },
                  { label: '当前油价 (元/L)', key: 'gasPrice', min: 4.0, max: 15.0, step: 0.1 },
                  { label: '电均价 (元/度)', key: 'elecPrice', min: 0.1, max: 3.0, step: 0.1 }
                ].map(param => (
                  <div key={param.key} className="space-y-2.5 group">
                    <div className="flex justify-between items-center">
                      <label className="text-xs font-semibold text-zinc-500 dark:text-zinc-400 tracking-wide">{param.label}</label>
                      <input 
                        type="number" min={param.min} max={param.max} step={param.step}
                        className={`w-18 px-2 py-1 text-sm bg-zinc-100 dark:bg-zinc-800 border border-transparent focus:bg-white focus:border-blue-500/50 dark:focus:bg-zinc-950 rounded-lg outline-none text-right font-medium ${springAnim}`}
                        value={globalParams[param.key]} 
                        onChange={(e) => handleGlobalChange(param.key, e.target.value)} 
                      />
                    </div>
                    <input 
                      type="range" min={param.min} max={param.max} step={param.step}
                      className="w-full accent-blue-500 h-1.5 bg-zinc-200 dark:bg-zinc-800 rounded-full appearance-none cursor-grab active:cursor-grabbing transition-opacity opacity-80 group-hover:opacity-100"
                      value={globalParams[param.key]} 
                      onChange={(e) => handleGlobalChange(param.key, e.target.value)} 
                    />
                  </div>
                ))}
              </div>
            </div>

            {/* 可视化图表卡片 (Apple Dashboard Style) */}
            <div className={`bg-white/80 dark:bg-zinc-900/80 backdrop-blur-2xl p-6 md:p-8 rounded-[28px] shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-none dark:border dark:border-white/5 flex-1 flex flex-col min-h-[480px] ${springAnim}`}>
              <div className="flex items-center gap-3 mb-8 shrink-0">
                <div className="p-2.5 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-xl">
                  <BarChart3 size={22} className="text-indigo-600 dark:text-indigo-400" />
                </div>
                <h2 className="text-xl md:text-2xl font-bold tracking-tight">TCO 总成本视图</h2>
              </div>

              {/* 核心横向滚动图表区 */}
              <div className="flex-1 w-full overflow-x-auto hide-scrollbar scroll-smooth relative">
                <div className="min-w-full w-max mx-auto flex items-end justify-center px-24 md:px-32 pb-8 pt-16 gap-28 sm:gap-36 md:gap-48 h-full">
                  {calculatedData.map((car, carIndex) => (
                    <div key={car.id} className="w-16 md:w-20 flex flex-col justify-end items-center group relative h-full shrink-0 mt-auto">
                      
                      {/* 顶部悬浮总价提示 */}
                      <div className={`absolute -top-14 opacity-0 group-hover:opacity-100 bg-zinc-900/90 dark:bg-white/90 backdrop-blur-md text-white dark:text-zinc-900 text-sm font-semibold py-1.5 px-3 rounded-xl whitespace-nowrap z-40 pointer-events-none shadow-xl transform group-hover:-translate-y-2 ${springAnim}`}>
                        ¥{car.totalTco.toLocaleString(undefined, {maximumFractionDigits:0})}
                      </div>

                      <div className="w-full h-[320px] flex flex-col justify-end relative rounded-t-lg overflow-visible">
                        
                        {/* 分段渲染堆叠图 */}
                        {['fixedMonthly', 'repair', 'maintenance', 'insurance', 'energy', 'depreciation']
                          .map((key) => {
                            return { key, value: car.breakdown[key] };
                          })
                          .filter(item => item.value > 0) // 【零值过滤】：只要值为0，直接剔除，隐藏全部UI
                          .map((item, stackIndex) => {
                            const percentage = (item.value / maxTco) * 100;
                            
                            // 只有 2 台车时，左车(0)向左，右车(1)向右；1台车或 3 台车及以上时，统一全部向左。
                            const isLabelLeft = calculatedData.length === 2 ? (carIndex === 0) : true;

                            return (
                              <div 
                                key={item.key} 
                                style={{ 
                                  height: isMounted ? `${percentage}%` : '0%', 
                                  backgroundColor: COLORS[item.key],
                                  minHeight: isMounted && percentage > 0 && percentage <= 1.5 ? '3px' : 'auto'
                                }}
                                className={`w-full relative group/segment cursor-crosshair border-t border-white/30 dark:border-zinc-950/30 first:rounded-t-md last:rounded-b-sm hover:brightness-110 hover:shadow-[0_0_15px_rgba(255,255,255,0.3)] z-10 hover:z-20 ${springAnim}`}
                              >
                                {isLabelLeft ? (
                                  /* 向左引出 */
                                  <div className={`absolute top-1/2 -translate-y-1/2 right-full pr-1.5 flex items-center justify-end pointer-events-none z-30 opacity-60 group-hover/segment:opacity-100 ${springAnim}`}>
                                    <div className="text-[11px] md:text-xs text-zinc-700 dark:text-zinc-200 whitespace-nowrap bg-white/80 dark:bg-zinc-800/80 backdrop-blur-xl shadow-sm border border-zinc-200/50 dark:border-zinc-700/50 px-2.5 py-1 rounded-lg font-medium tracking-tight mr-1.5">
                                      {LEGEND.find(l => l.key === item.key).label}: ¥{item.value.toLocaleString(undefined, {maximumFractionDigits:0})}
                                    </div>
                                    <div className="h-[1.5px] bg-zinc-300 dark:bg-zinc-700 w-6 md:w-12 rounded-full" />
                                  </div>
                                ) : (
                                  /* 向右引出 */
                                  <div className={`absolute top-1/2 -translate-y-1/2 left-full pl-1.5 flex items-center justify-start pointer-events-none z-30 opacity-60 group-hover/segment:opacity-100 ${springAnim}`}>
                                    <div className="h-[1.5px] bg-zinc-300 dark:bg-zinc-700 w-6 md:w-12 rounded-full" />
                                    <div className="text-[11px] md:text-xs text-zinc-700 dark:text-zinc-200 whitespace-nowrap bg-white/80 dark:bg-zinc-800/80 backdrop-blur-xl shadow-sm border border-zinc-200/50 dark:border-zinc-700/50 px-2.5 py-1 rounded-lg font-medium tracking-tight ml-1.5">
                                      {LEGEND.find(l => l.key === item.key).label}: ¥{item.value.toLocaleString(undefined, {maximumFractionDigits:0})}
                                    </div>
                                  </div>
                                )}
                              </div>
                            );
                        })}
                      </div>
                      
                      {/* X轴底部标签 */}
                      <div className="mt-6 text-center w-36 md:w-48 flex flex-col items-center">
                        <div className="text-[13px] md:text-sm font-bold text-zinc-800 dark:text-zinc-100 break-words whitespace-normal leading-tight px-2" title={car.name}>
                          {car.name}
                        </div>
                        <div className="text-[11px] md:text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 mt-1.5 bg-zinc-100 dark:bg-zinc-800/50 px-2.5 py-0.5 rounded-full">
                          ¥{car.totalTco.toLocaleString(undefined, {maximumFractionDigits:0})}
                        </div>
                      </div>
                    </div>
                  ))}
                  
                  {calculatedData.length === 0 && (
                    <div className="text-zinc-400 dark:text-zinc-600 text-sm h-full flex items-center justify-center w-full absolute inset-0 font-medium">
                      请在右侧控制台添加车辆配置
                    </div>
                  )}
                </div>
              </div>

              {/* 优雅的图例 */}
              <div className="flex flex-wrap gap-x-5 gap-y-3 mt-4 text-[11px] font-medium text-zinc-600 dark:text-zinc-400 justify-center shrink-0 border-t border-zinc-100 dark:border-zinc-800/50 pt-6">
                {LEGEND.map(item => (
                  <div key={item.key} className="flex items-center gap-2">
                    <div className="w-3 h-3 rounded-full shadow-inner" style={{ backgroundColor: item.color }} />
                    <span className="tracking-wide">{item.label}</span>
                  </div>
                ))}
              </div>

            </div>
          </div>

          {/* ================= 右侧区域：车辆详情输入列表 ================= */}
          <div className="w-full xl:w-7/12 flex flex-col gap-5 overflow-y-auto pb-10">
            
            {/* 添加车辆顶部栏 (Sticky Apple Header) */}
            <div className={`bg-white/80 dark:bg-zinc-900/80 backdrop-blur-2xl p-4 md:p-5 rounded-[24px] shadow-[0_4px_20px_rgb(0,0,0,0.03)] dark:shadow-none dark:border dark:border-white/5 flex items-center justify-between sticky top-0 z-20 ${springAnim}`}>
              <div>
                <h3 className="text-lg font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">车辆参数配置池</h3>
                <p className="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1 font-medium">当前共对比 {cars.length} 款车型</p>
              </div>
              <button 
                onClick={handleAddCar}
                className={`px-5 py-2.5 bg-blue-600 dark:bg-blue-500 text-white font-semibold rounded-full hover:bg-blue-700 dark:hover:bg-blue-400 hover:shadow-lg hover:shadow-blue-500/20 active:scale-95 flex items-center gap-2 ${springAnim}`}
              >
                <Plus size={18} strokeWidth={2.5} />
                <span className="hidden sm:inline">新增对比方案</span>
              </button>
            </div>

            {/* 车辆详情卡片 */}
            {cars.map((car, index) => (
              <div key={car.id} className={`bg-white dark:bg-zinc-900 p-6 md:p-7 rounded-[28px] shadow-[0_8px_30px_rgb(0,0,0,0.02)] hover:shadow-[0_15px_40px_rgb(0,0,0,0.06)] dark:shadow-none dark:border dark:border-white/5 relative group ${springAnim}`}>
                
                {/* 卡片 Header */}
                <div className="flex items-center justify-between mb-6 border-b border-zinc-100 dark:border-zinc-800/80 pb-5">
                  <div className="flex items-center gap-4 flex-1 pr-4">
                    <div className={`p-3 rounded-2xl shrink-0 ${springAnim} ${ICON_THEMES[index % ICON_THEMES.length]}`}>
                      {car.type === 'phev' ? (
                        <div className="flex items-center space-x-1">
                          <Droplet size={18} />
                          <Zap size={18} />
                        </div>
                      ) : car.type === 'ev' ? (
                        <Zap size={24} />
                      ) : (
                        <Fuel size={24} />
                      )}
                    </div>
                    <input 
                      type="text" 
                      value={car.name}
                      onChange={(e) => handleCarChange(car.id, 'name', e.target.value)}
                      className={`font-bold text-xl md:text-2xl text-zinc-900 dark:text-zinc-100 bg-transparent border-b-2 border-transparent hover:border-zinc-200 dark:hover:border-zinc-700 focus:border-blue-500 outline-none w-full max-w-[280px] tracking-tight ${springAnim}`}
                      placeholder="输入方案名称..."
                    />
                  </div>
                  
                  <div className="flex items-center gap-3 shrink-0">
                    <select 
                      value={car.type}
                      onChange={(e) => handleCarChange(car.id, 'type', e.target.value)}
                      className={`text-sm font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 px-4 py-2 rounded-xl outline-none cursor-pointer border border-transparent hover:border-zinc-300 dark:hover:border-zinc-600 appearance-none ${springAnim}`}
                    >
                      <option value="gas">纯燃油车</option>
                      <option value="phev">插混/增程</option>
                      <option value="ev">纯电动车</option>
                    </select>
                    <button 
                      onClick={() => setCars(cars.filter(c => c.id !== car.id))}
                      className={`p-2.5 text-zinc-400 dark:text-zinc-500 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-xl ${springAnim}`}
                      title="移除方案"
                    >
                      <Trash2 size={20} />
                    </button>
                  </div>
                </div>

                {/* 参数输入网格 */}
                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-5">
                  
                  {/* ====== 资产属性 ====== */}
                  <div className="col-span-full sm:col-span-2 lg:col-span-3 pb-2">
                    <h4 className="text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-widest mb-4">资产投入与折旧</h4>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-6">
                      <div className="group">
                        <label className="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-2">初始买入总额 (元)</label>
                        <div className="relative">
                          <span className="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400 font-medium text-sm">¥</span>
                          <input 
                            type="number" step="1000"
                            value={car.initialCost}
                            onChange={(e) => handleCarChange(car.id, 'initialCost', Number(e.target.value))}
                            className={`w-full pl-8 pr-4 py-3 bg-zinc-50 dark:bg-zinc-800/50 border border-transparent group-hover:border-zinc-200 dark:group-hover:border-zinc-700 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-blue-500 text-zinc-900 dark:text-zinc-100 rounded-xl outline-none font-medium ${springAnim}`}
                          />
                        </div>
                      </div>
                      <div className="group">
                        <label className="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-2">期末卖出残值 (元)</label>
                        <div className="relative">
                          <span className="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400 font-medium text-sm">¥</span>
                          <input 
                            type="number" step="1000"
                            value={car.residualValue}
                            onChange={(e) => handleCarChange(car.id, 'residualValue', Number(e.target.value))}
                            className={`w-full pl-8 pr-4 py-3 bg-zinc-50 dark:bg-zinc-800/50 border border-transparent group-hover:border-zinc-200 dark:group-hover:border-zinc-700 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-blue-500 text-zinc-900 dark:text-zinc-100 rounded-xl outline-none font-medium ${springAnim}`}
                          />
                        </div>
                      </div>
                    </div>
                  </div>

                  <div className="col-span-full border-t border-zinc-100 dark:border-zinc-800/50 my-1"></div>

                  {/* ====== 运营开销 ====== */}
                  <div className="col-span-full lg:col-span-2 space-y-4">
                    <h4 className="text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-widest mb-4">日常运营开销</h4>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-5">
                      {car.type === 'phev' ? (
                        <>
                          <div className="group">
                            <label className="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-2">电耗 (kWh/100km)</label>
                            <input 
                              type="number" step="0.1"
                              value={car.energyConsumption}
                              onChange={(e) => handleCarChange(car.id, 'energyConsumption', Number(e.target.value))}
                              className={`w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-800/50 border border-transparent group-hover:border-zinc-200 dark:group-hover:border-zinc-700 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-blue-500 text-zinc-900 dark:text-zinc-100 rounded-xl outline-none font-medium ${springAnim}`}
                            />
                          </div>
                          <div className="group">
                            <label className="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-2">亏电油耗 (L/100km)</label>
                            <input 
                              type="number" step="0.1"
                              value={car.phevGasConsumption}
                              onChange={(e) => handleCarChange(car.id, 'phevGasConsumption', Number(e.target.value))}
                              className={`w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-800/50 border border-transparent group-hover:border-zinc-200 dark:group-hover:border-zinc-700 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-blue-500 text-zinc-900 dark:text-zinc-100 rounded-xl outline-none font-medium ${springAnim}`}
                            />
                          </div>
                          <div className="col-span-full sm:col-span-2 bg-blue-50 dark:bg-blue-500/5 p-4 rounded-2xl border border-blue-100 dark:border-blue-500/10">
                            <div className="flex justify-between items-center mb-3">
                              <label className="block text-xs font-semibold text-blue-800 dark:text-blue-300">纯电代步比例设置</label>
                              <span className="text-sm font-bold text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30 px-2 py-0.5 rounded-md">{car.evRatio}% 用电</span>
                            </div>
                            <input 
                              type="range" min="0" max="100" step="1"
                              value={car.evRatio}
                              onChange={(e) => handleCarChange(car.id, 'evRatio', Number(e.target.value))}
                              className="w-full accent-blue-500 h-2 bg-blue-200/50 dark:bg-blue-900/30 rounded-full appearance-none cursor-grab active:cursor-grabbing"
                            />
                          </div>
                        </>
                      ) : (
                        <div className="group">
                          <label className="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-2">百公里能耗 ({car.type === 'gas' ? 'L' : 'kWh'})</label>
                          <input 
                            type="number" step="0.1"
                            value={car.energyConsumption}
                            onChange={(e) => handleCarChange(car.id, 'energyConsumption', Number(e.target.value))}
                            className={`w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-800/50 border border-transparent group-hover:border-zinc-200 dark:group-hover:border-zinc-700 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-blue-500 text-zinc-900 dark:text-zinc-100 rounded-xl outline-none font-medium ${springAnim}`}
                          />
                        </div>
                      )}
                      <div className="group">
                        <label className="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-2">首年商业/交强险 (元)</label>
                        <input 
                          type="number" step="100"
                          value={car.firstYearInsurance}
                          onChange={(e) => handleCarChange(car.id, 'firstYearInsurance', Number(e.target.value))}
                          className={`w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-800/50 border border-transparent group-hover:border-zinc-200 dark:group-hover:border-zinc-700 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-blue-500 text-zinc-900 dark:text-zinc-100 rounded-xl outline-none font-medium ${springAnim}`}
                        />
                      </div>
                      <div className="group">
                        <label className="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-2">年均常规保养费 (元/年)</label>
                        <input 
                          type="number" step="100"
                          value={car.maintenancePerYear}
                          onChange={(e) => handleCarChange(car.id, 'maintenancePerYear', Number(e.target.value))}
                          className={`w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-800/50 border border-transparent group-hover:border-zinc-200 dark:group-hover:border-zinc-700 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-blue-500 text-zinc-900 dark:text-zinc-100 rounded-xl outline-none font-medium ${springAnim}`}
                        />
                      </div>
                      <div className="group">
                        <label className="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-2">换电/电池月租 (元/月)</label>
                        <input 
                          type="number" step="50"
                          value={car.fixedMonthlyCost}
                          onChange={(e) => handleCarChange(car.id, 'fixedMonthlyCost', Number(e.target.value))}
                          className={`w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-800/50 border border-transparent group-hover:border-zinc-200 dark:group-hover:border-zinc-700 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-blue-500 text-zinc-900 dark:text-zinc-100 rounded-xl outline-none font-medium ${springAnim}`}
                        />
                      </div>
                    </div>
                  </div>

                  {/* ====== 风险金模块 ====== */}
                  <div className="col-span-full sm:col-span-1 lg:border-l lg:border-zinc-100 dark:lg:border-zinc-800/50 lg:pl-6 space-y-4">
                    <h4 className="text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-widest mb-4">老化维系金</h4>
                    <div className="group">
                      <label className="block text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-2 flex items-center gap-1.5">
                        年度备用金 (元)
                        <span title="对冲二手老车老化故障风险，新车建议填0" className="cursor-help text-zinc-400 hover:text-blue-500"><Info size={14} strokeWidth={2.5}/></span>
                      </label>
                      <input 
                        type="number" step="500"
                        value={car.repairFundPerYear}
                        onChange={(e) => handleCarChange(car.id, 'repairFundPerYear', Number(e.target.value))}
                        className={`w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-800/50 border border-transparent group-hover:border-zinc-200 dark:group-hover:border-zinc-700 focus:bg-white dark:focus:bg-zinc-900 focus:ring-2 focus:ring-blue-500 text-zinc-900 dark:text-zinc-100 rounded-xl outline-none font-medium ${springAnim}`}
                      />
                      <div className="mt-3 p-3 bg-zinc-50/80 dark:bg-zinc-800/30 rounded-xl text-[11px] text-zinc-500 dark:text-zinc-400 font-medium leading-relaxed">
                        推荐设置：<br/>
                        • 高龄老车：3000-5000<br/>
                        • 优质二手：1000-2000<br/>
                        • 在保新车：0
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    </div>
  );
}
